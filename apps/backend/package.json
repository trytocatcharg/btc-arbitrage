{
  "name": "@btc-arbitrage/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "yarn build && node dist/main.js",
    "start": "node dist/main.js",
    "build": "yarn run -T tsc -b tsconfig.json --pretty false",
    "typecheck": "yarn run -T tsc -b tsconfig.json --pretty false",
    "lint": "yarn run -T tsc -b tsconfig.json --pretty false",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@btc-arbitrage/config": "workspace:*",
    "@btc-arbitrage/domain": "workspace:*",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "tsx": "4.19.2"
  }
}
