{
  "name": "@btc-arbitrage/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "yarn run -T tsx src/main.ts",
    "start": "node dist/main.js",
    "build": "yarn run -T tsc -p tsconfig.json",
    "typecheck": "yarn run -T tsc -b tsconfig.json --pretty false",
    "lint": "yarn run -T tsc -b tsconfig.json --pretty false",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:watch": "node --test --watch dist-test/**/*.test.js"
  },
  "dependencies": {
    "@btc-arbitrage/config": "workspace:*",
    "@btc-arbitrage/db": "workspace:*",
    "@btc-arbitrage/domain": "workspace:*",
    "@btc-arbitrage/exchange-core": "workspace:*",
    "@btc-arbitrage/shared": "workspace:*",
    "@noble/curves": "1.7.0",
    "@noble/hashes": "1.6.0",
    "@x10xchange/stark-crypto-wrapper-wasm": "0.1.6",
    "starknet": "8.5.4"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
