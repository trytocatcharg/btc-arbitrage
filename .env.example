# Core runtime
DATABASE_HOST_NAME=127.0.0.1
DATABASE_USER_NAME=user
DB_PORT=3306
DATABASE_USER_PASSWORD=password
DATABASE_DB_NAME=btc_arbitrage
BOT_EXECUTION_MODE=dry-run
BOT_RUN_ONCE=false
BTC_SYMBOL=BTCUSDT
MARKET_TYPE=perpetual
PRICE_SOURCE=mark
PRICE_POLL_INTERVAL_MS=1000
MIN_PRICE_DIFF_USD=40
LEVERAGE=3
MAX_LEVERAGE=3
REPO_URL=https://github.com/trytocatcharg/btc-arbitrage.git

# Exchange selection
EXCHANGE_A=risex
EXCHANGE_B=extended
EXCHANGE_LONG=
EXCHANGE_SHORT=

# RISEx read/write gates
RISEX_API_BASE_URL=https://api.rise.trade
RISEX_ACCOUNT_ADDRESS=
RISEX_TRADING_ENABLED=false
RISEX_PRIVATE_KEY=

# Extended read/write gates
EXTENDED_API_BASE_URL=https://api.starknet.extended.exchange
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_TRADING_ENABLED=false
EXTENDED_USER_AGENT=btc-arbitrage-bot/0.1


# Arcus read/write gates
ARCUS_API_BASE_URL=https://api.arcus.xyz
ARCUS_API_KEY=
ARCUS_ACCOUNT_ADDRESS=
ARCUS_TRADING_ENABLED=false
ARCUS_USER_AGENT=btc-arbitrage-bot/0.1

# Global order-placement gates. Keep disabled until live trading is explicitly implemented and reviewed.
ENABLE_ORDER_PLACEMENT=false
CONFIRM_LIVE_TRADING=

# Telegram alerting
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_MS=3600000

# Optional read-only API / web
READ_API_ENABLED=true
READ_API_HOST=127.0.0.1
READ_API_PORT=3001
WEB_API_BASE_URL=http://127.0.0.1:3001

# Express backend API / web balances
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3002
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_BACKEND_API_BASE_URL=http://127.0.0.1:3002
LOG_LEVEL=info
