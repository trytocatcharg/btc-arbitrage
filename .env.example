# Core runtime
DATABASE_HOST_NAME=127.0.0.1
DATABASE_USER_NAME=user
DB_PORT=3306
DATABASE_USER_PASSWORD=password
DATABASE_DB_NAME=btc_arbitrage
BOT_EXECUTION_MODE=dry-run
BOT_RUN_ONCE=false
BTC_SYMBOL=BTCUSDT
MARKET_TYPE=perpetual
PRICE_SOURCE=mark
PRICE_POLL_INTERVAL_MS=1000
MIN_PRICE_DIFF_USD=40
LEVERAGE=3
REPO_URL=https://github.com/trytocatcharg/btc-arbitrage.git

# Exchange selection
EXCHANGE_A=risex
EXCHANGE_B=extended
EXCHANGE_LONG=
EXCHANGE_SHORT=

# RISEx read/write gates
RISEX_API_BASE_URL=https://api.rise.trade
RISEX_ACCOUNT_ADDRESS=
RISEX_ACCOUNT_PRIVATE_KEY=
RISEX_TRADING_ENABLED=false
RISEX_SESSION_SIGNER_PRIVATE_KEY=

# Extended read/write gates
EXTENDED_API_BASE_URL=https://api.starknet.extended.exchange
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_VAULT_ID=
EXTENDED_TRADING_ENABLED=false
EXTENDED_USER_AGENT=btc-arbitrage-bot/0.1


# Arcus read/write gates
ARCUS_API_BASE_URL=https://api.arcus.xyz
ARCUS_API_KEY=
# Ed25519 signing seed (64 hex chars). Required only when ARCUS_TRADING_ENABLED=true. Never commit a real value.
ARCUS_API_PRIVATE_KEY=
ARCUS_ACCOUNT_ADDRESS=
ARCUS_TRADING_ENABLED=false
ARCUS_USER_AGENT=btc-arbitrage-bot/0.1
# Optional explicit overrides for the Arcus routing fee inputs (basis points).
# When unset, the bot resolves the live base tier (level 0, most expensive/
# conservative) from the public GET /v1/feetiers table once at startup.
#ARCUS_MAKER_FEE_BPS=2
#ARCUS_TAKER_FEE_BPS=5
# goodTilTime lifetime for placed orders in days (Arcus requires >= 31; default 90).
ARCUS_ORDER_EXPIRATION_DAYS=90

# Global order-placement gates. Keep disabled until live trading is explicitly implemented and reviewed.
ENABLE_ORDER_PLACEMENT=false
CONFIRM_LIVE_TRADING=

# Open Trade safety controls
OPEN_TRADE_NOTIONAL_USD=100
OPEN_TRADE_PREVIEW_TTL_MS=120000
OPEN_TRADE_QUOTE_MAX_AGE_MS=5000
OPEN_TRADE_LIMIT_TIMEOUT_MS=30000
OPEN_TRADE_RESIDUAL_DELTA_BTC=0.00001
OPEN_TRADE_TAKE_PROFIT_PERCENT=3
OPEN_TRADE_STOP_LOSS_PERCENT=2.5
# Fill-time edge band: keep a trade only if expected convergence covers exit
# cost (fees + slippage) plus OPEN_TRADE_MIN_PROFIT_USD; otherwise both legs
# close immediately at market (edge_below_cost)
OPEN_TRADE_MIN_PROFIT_USD=0.05
# Runtime assertion bound for the edge-abort path (fee-model drift alert)
OPEN_TRADE_MAX_LOSS_USD=0.25
# Assumed exit slippage (basis points) for the edge band computation
OPEN_TRADE_SLIPPAGE_BPS=2  
# RISEx defaults below match Tier 1 from docs/exchanges/risex.md; override if your 14-day volume moves you to another tier
RISEX_MAKER_FEE_BPS=1
RISEX_TAKER_FEE_BPS=3
# Extended defaults below match docs/exchanges/extended.md
EXTENDED_MAKER_FEE_BPS=0
EXTENDED_TAKER_FEE_BPS=2.5
# Variational has no fee schedule; the real cost is the RFQ spread (base_spread_bps),
# which is captured in the quote itself. These bps only feed the open-trade routing tiebreak.
VARIATIONAL_MAKER_FEE_BPS=0
VARIATIONAL_TAKER_FEE_BPS=0
# QFEX defaults below are placeholders pending live fee verification; the venue
# exposes per-account fractions via GET /user/fees (docs/exchanges/qfex.md)
QFEX_MAKER_FEE_BPS=1
QFEX_TAKER_FEE_BPS=3

# Telegram alerting
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_COOLDOWN_MS=3600000

# Express backend API / web balances
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3002
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_BACKEND_API_BASE_URL=http://127.0.0.1:3002
LOG_LEVEL=info

# Variational SIWE auth + trading gates
VARIATIONAL_API_BASE_URL=https://omni.variational.io/api
VARIATIONAL_PRICE_API_BASE_URL=https://omni-client-api.prod.ap-northeast-1.variational.io
VARIATIONAL_ACCOUNT_ADDRESS=
VARIATIONAL_ACCOUNT_PRIVATE_KEY=
VARIATIONAL_REFERRAL_CODE=
VARIATIONAL_TRADING_ENABLED=false
VARIATIONAL_USER_AGENT=btc-arbitrage-bot/0.1
VARIATIONAL_PRICE_CACHE_TTL_MS=5000

# QFEX read/write gates (order entry is WebSocket-only; see docs/exchanges/qfex.md)
QFEX_API_BASE_URL=https://api.qfex.com
QFEX_WS_BASE_URL=wss://trade.qfex.com
QFEX_API_KEY=
QFEX_SECRET_KEY=
# Optional subaccount UUID (x-qfex-requested-account-id / WS auth account_id); omit for the primary account
#QFEX_ACCOUNT_ID=
QFEX_TRADING_ENABLED=false
QFEX_USER_AGENT=btc-arbitrage-bot/0.1

# Data retention (daily prune of price_snapshots, spread_snapshots, signals)
# Signals referenced by trades/trade_previews are always preserved.
DATA_RETENTION_ENABLED=true
DATA_RETENTION_DAYS=30
DATA_RETENTION_BATCH_SIZE=5000

# Gold/silver ratio strategy (Arcus-only GLD/SLV pair trade). Opened ON
# DEMAND from the Telegram /ratio command — no pair selection, coexists
# with the spread pair. The tick/exit pass runs only while a G/S trade is
# active. Sizing and the entry loop have their own vars (split from the
# shared OPEN_TRADE_*/LEVERAGE by gold-silver-decouple).
GOLDSILVER_MARGIN_USD=20
GOLDSILVER_LEVERAGE=3
GOLDSILVER_LIMIT_TIMEOUT_MS=30000
GOLDSILVER_LIMIT_REPRICE_INTERVAL_MS=2000
GOLDSILVER_ENTRY_IMPROVE_TICKS=1
GOLDSILVER_CANDLE_TIMEFRAME=1h
GOLDSILVER_CANDLE_LIMIT=200
GOLDSILVER_RSI_PERIOD=14
GOLDSILVER_RSI_CONFIRM_BAND=0
GOLDSILVER_PRICE_POLL_INTERVAL_MS=5000
GOLDSILVER_STOP_LOSS_MARGIN_PERCENT=50
GOLDSILVER_TP_MIN_NET_USD=10
GOLDSILVER_EXIT_REPRICE_INTERVAL_MS=2000
GOLDSILVER_EXIT_SLIPPAGE_BUDGET_BPS=40
GOLDSILVER_EXIT_MAX_WAIT_MS=60000
GOLDSILVER_EXIT_MAX_REPRICES=8
GOLDSILVER_TIME_STOP_HOURS=48
